# ─────────────────────────────────────────────────────────────────────────────
# REHMAN PERFUME — backend configuration
#
# Copy this file to `.env` (which is gitignored) and fill in the two services.
# Every value below is a PLACEHOLDER: the app boots and serves the whole
# catalogue, photographs included, with these exactly as they are. Cloudinary is
# optional — with no account configured, uploads are written to this machine's
# disk instead and served from /api/uploads. See STORAGE_DRIVER below.
#
# `npm run smoke` needs none of this — it supplies its own throwaway database.
# ─────────────────────────────────────────────────────────────────────────────

PORT=8000
NODE_ENV=development

# ── MongoDB — every data table lives here ────────────────────────────────────
# Create a free cluster at https://cloud.mongodb.com, then Database → Connect →
# Drivers, and paste the connection string over this one. Substitute the real
# user, password and cluster host; keep the /rehman database name.
#
# For a MongoDB running on this machine instead, use:
#   MONGODB_URI=mongodb://127.0.0.1:27017/rehman?replicaSet=rs0
# A replica set is required — stock movements and order placement run in a
# transaction, which a standalone mongod cannot do. Atlas always is one.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/rehman?retryWrites=true&w=majority

# ── Cloudinary — product images, review photos, atelier files (optional) ─────
# Free account at https://cloudinary.com; these four are on the dashboard home.
# Only the bytes live there. Every record *about* a file lives in MongoDB.
#
# Leave these as placeholders to run without an account: uploads then go to disk
# (see the storage section below) and the panel says so on the drop zone.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Prefix for every folder this app writes to, so it can share an account.
CLOUDINARY_FOLDER=rehman

# ── Where uploaded files live ────────────────────────────────────────────────
# `auto` (the default) uses Cloudinary when the three credentials above are real
# and this machine's disk when they are not, so uploads work out of the box.
#
# Force one or the other with `cloudinary` or `local`. Forcing `cloudinary`
# without credentials is honoured rather than silently downgraded, so uploads
# answer 503 with an explanation instead of half-working — use it in production
# to guarantee photographs never land on an ephemeral container's disk.
#
# STORAGE_DRIVER=auto
#
# Only meaningful for the `local` driver. Defaults to `<backend>/uploads`, which
# is created on demand and holds the shop's own photographs. If you version this
# project with git, exclude that directory — the files are data, not source.
# Point it at a mounted volume in production, or at any path this process can
# write to.
# UPLOADS_DIR=
#
# Files are served from /api/uploads, which is why they travel the same Vite dev
# proxy as the rest of the API and need no second configuration in either
# frontend.

# ── Sessions ─────────────────────────────────────────────────────────────────
# Signs the httpOnly session cookie. Generate one with:
#   node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
# Refused outright when NODE_ENV=production, so a placeholder cannot ship.
JWT_SECRET=replace-with-a-long-random-string
# Set true once the API is served over HTTPS — the cookie is then Secure.
COOKIE_SECURE=false
# How long a session survives with nothing happening, for every role. The clock
# is slid forward by each request, so this is "away from the keyboard" time and
# not a countdown from sign-in: an owner and a shopper alike are signed out and
# made to sign in again after four idle hours.
SESSION_IDLE_HOURS=4
# The ceiling that idling cannot push past. A session can be kept alive by use,
# but never for longer than this, however busy it is.
SESSION_MAX_DAYS=7

# ── The two frontends this API serves ────────────────────────────────────────
# Credentials are sent cross-origin, so this is an explicit list, never a *.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Google sign-in ("Continue with Google") ──────────────────────────────────
# Create an OAuth client at https://console.cloud.google.com → APIs & Services →
# Credentials → Create credentials → OAuth client ID → Web application.
#
# Authorised redirect URIs must contain EXACTLY this, ready for production too:
#   http://localhost:8000/api/auth/google/callback
#   https://your-api-host/api/auth/google/callback
#
# Until both values below are filled in the flow answers 503 and the login page
# simply does not show the button. Nothing else in the app is affected.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must match the console entry character for character. Only change this if the
# API is reachable at a different address.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Optional, and empty by default: with no list, anyone with a Google account may
# sign in and gets a new patron record — which is what a shop wants. Fill it in
# to run a closed preview where only these addresses are admitted, and where a
# matching address is also given a staff role.
# GOOGLE_ADMIN_EMAILS=you@example.com,manager@example.com

# ── Pricing defaults ─────────────────────────────────────────────────────────
# Seeded into the `settings` collection on first run; after that the database is
# the authority and these are only what a fresh install starts from.
SHIPPING_FEE=79
FREE_SHIPPING_OVER=999

# ── Brevo Transactional Email (Forgot Password, Email Verification, Orders) ──
# Create an API key at https://app.brevo.com/settings/keys/api and verify a
# sender address under Senders, Domains & Dedicated IPs → Senders.
# Until a real BREVO_API_KEY is set, forgot-password / verification codes fall
# back safely to EmailLog preview + server console output.
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=your-verified-sender@example.com
BREVO_SENDER_NAME=Rehman Perfume

# ── UptimeRobot & Render Keep-Alive ─────────────────────────────────────────
# On Render free tier, web services idle/sleep after 15 minutes of inactivity.
# 1. Point UptimeRobot (https://uptimerobot.com) to:
#    https://raheman-api.onrender.com/api/ping (or https://raheman-api.onrender.com/ping)
#    with a 5-minute monitoring interval.
# 2. Render automatically injects RENDER_EXTERNAL_URL; the backend self-pings
#    every 5 minutes as a built-in safety net. You can override it here if needed:
# KEEP_ALIVE_URL=https://raheman-api.onrender.com
# KEEP_ALIVE_INTERVAL_MINUTES=5

# ── Razorpay Payment Gateway (Online UPI, Cards, NetBanking) ─────────────────
# Get your API Key ID and Key Secret from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret


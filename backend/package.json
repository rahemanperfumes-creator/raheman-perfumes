{
  "name": "rehman-perfume-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "REHMAN PERFUME — API: Express + MongoDB (data) + Cloudinary (files and images)",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "start:cluster": "pm2 start ecosystem.config.cjs --env production",
    "stop:cluster": "pm2 stop ecosystem.config.cjs",
    "reload:cluster": "pm2 reload ecosystem.config.cjs --update-env",
    "seed": "node scripts/seed.mjs",
    "seed:fresh": "node scripts/seed.mjs --fresh",
    "backfill:barcodes": "node scripts/backfill-barcodes.mjs"
  },
  "dependencies": {
    "agentmail": "0.5.54",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.1",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "nodemailer": "^10.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.2"
  }
}
